{
  "name": "Lumina Claro",
  "dataColors": [
    "#1F6F8B",
    "#EF7D62",
    "#F2B84B",
    "#4FB3A9",
    "#8C7BC9",
    "#9DCBDB",
    "#7F8C97",
    "#16425B"
  ],
  "background": "#FFFFFF",
  "foreground": "#1F2D3A",
  "tableAccent": "#1F6F8B",
  "good": "#1F6F8B",
  "neutral": "#F2B84B",
  "bad": "#EF7D62",
  "textClasses": {
    "callout": {
      "fontSize": 18,
      "fontFace": "Segoe UI Semibold",
      "color": "#1F6F8B"
    },
    "title": {
      "fontSize": 11,
      "fontFace": "Segoe UI Semibold",
      "color": "#16425B"
    },
    "header": {
      "fontSize": 11,
      "fontFace": "Segoe UI Semibold",
      "color": "#16425B"
    },
    "label": {
      "fontSize": 9,
      "fontFace": "Segoe UI",
      "color": "#5B6B78"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#E8F0F4"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#D2DFE6"
              }
            },
            "radius": 10
          }
        ],
        "dropShadow": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#16425B"
              }
            },
            "transparency": 82,
            "position": "Outer",
            "preset": "BottomRight"
          }
        ],
        "title": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#16425B"
              }
            },
            "fontSize": 11,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "visualHeader": [
          {
            "background": {
              "solid": {
                "color": "#E8F0F4"
              }
            },
            "foreground": {
              "solid": {
                "color": "#5B6B78"
              }
            },
            "transparency": 0
          }
        ],
        "categoryAxis": [
          {
            "labelColor": {
              "solid": {
                "color": "#1F2D3A"
              }
            },
            "fontSize": 9,
            "showAxisTitle": false,
            "gridlineShow": false,
            "maxMarginFactor": 45,
            "concatenateLabels": false
          }
        ],
        "valueAxis": [
          {
            "show": false,
            "showAxisTitle": false,
            "gridlineShow": false
          }
        ],
        "labels": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#1F2D3A"
              }
            },
            "fontSize": 9,
            "labelDisplayUnits": 1
          }
        ],
        "legend": [
          {
            "show": true,
            "position": "Top",
            "labelColor": {
              "solid": {
                "color": "#5B6B78"
              }
            },
            "fontSize": 9
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#F5F8FA"
              }
            },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#E3EAEE"
              }
            },
            "transparency": 0
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "color": {
              "solid": {
                "color": "#1F6F8B"
              }
            },
            "fontSize": 16
          }
        ],
        "categoryLabels": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#5B6B78"
              }
            },
            "fontSize": 9
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "data": [
          {
            "mode": "Dropdown"
          }
        ],
        "header": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#5B6B78"
              }
            },
            "textSize": 9
          }
        ],
        "items": [
          {
            "fontColor": {
              "solid": {
                "color": "#1F2D3A"
              }
            },
            "background": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "textSize": 10
          }
        ],
        "title": [
          {
            "show": false
          }
        ]
      }
    },
    "donutChart": {
      "*": {
        "legend": [
          {
            "show": true,
            "position": "Bottom",
            "labelColor": {
              "solid": {
                "color": "#5B6B78"
              }
            },
            "fontSize": 9
          }
        ],
        "labels": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#1F2D3A"
              }
            },
            "fontSize": 9,
            "labelStyle": "Percent of total"
          }
        ]
      }
    },
    "pieChart": {
      "*": {
        "legend": [
          {
            "show": true,
            "position": "Right",
            "labelColor": {
              "solid": {
                "color": "#5B6B78"
              }
            },
            "fontSize": 9
          }
        ],
        "labels": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#1F2D3A"
              }
            },
            "fontSize": 9,
            "labelStyle": "Percent of total"
          }
        ]
      }
    },
    "barChart": {
      "*": {
        "labels": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "fontSize": 8,
            "labelDisplayUnits": 1
          }
        ]
      }
    }
  }
}