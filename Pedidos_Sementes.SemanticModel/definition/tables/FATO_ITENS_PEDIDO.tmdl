	column LOCAL_MAPA = FATO_ITENS_PEDIDO[CIDADE_CLIENTE] & ", " & FATO_ITENS_PEDIDO[UF_CLIENTE] & ", Brasil"
		dataType: string
		lineageTag: f1cfc037-8a7e-4ccc-bc3d-fab1bf3412f4
		dataCategory: Place
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column VENDEDOR_PRINCIPAL = VAR _g = LOOKUPVALUE ( dVendedorPrincipal[VENDEDOR_PRINCIPAL], dVendedorPrincipal[CHAVE], TRIM ( FATO_ITENS_PEDIDO[GRUPO_VENDEDOR] ) ) VAR _v = LOOKUPVALUE ( dVendedorPrincipal[VENDEDOR_PRINCIPAL], dVendedorPrincipal[CHAVE], TRIM ( FATO_ITENS_PEDIDO[VENDEDOR] ) ) RETURN COALESCE ( _g, _v, "Sem vínculo" )
		dataType: string
		lineageTag: 9125b995-b1a5-4b2c-bd08-0789ce04948d
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column CANAL = VAR _v = LOOKUPVALUE ( dVendedorPrincipal[VENDEDOR_PRINCIPAL], dVendedorPrincipal[CHAVE], TRIM ( FATO_ITENS_PEDIDO[VENDEDOR] ) ) VAR _nome = TRIM ( FATO_ITENS_PEDIDO[VENDEDOR] ) RETURN IF ( _v = FATO_ITENS_PEDIDO[VENDEDOR_PRINCIPAL] || _nome = "Sem Vendedor" || _nome = "", "Venda direta", _nome )
		dataType: string
		lineageTag: 75212c4f-b177-4988-80f9-5516043f7412
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column EMBALAGEM = VAR _u = TRIM ( FATO_ITENS_PEDIDO[UNIDADE_ORIGINAL] ) VAR _c = UPPER ( FATO_ITENS_PEDIDO[NOME_CULTURA] ) RETURN SWITCH ( TRUE (), _u = "5MM", "Bag", _u = "SC200", "Saca 200 mil", _u = "4MM", "Bag 4 milhões", _u = "140M", "Saca 140 mil", _u = "60M", "Saca 60 mil", _u = "80M", "Saca 80 mil", LEFT ( _u, 4 ) = "INAT" && CONTAINSSTRING ( _c, "MILHO" ), "Saca (cód. antigo)", LEFT ( _u, 4 ) = "INAT", "Bag (cód. antigo)", LEFT ( _u, 2 ) = "BB", "Bigbag " & TRIM ( MID ( _u, 3, 10 ) ) & " kg", _u = "TON", "Tonelada", _u = "KG", "Kg", LEFT ( _u, 2 ) = "SC", "Saco " & TRIM ( MID ( _u, 3, 10 ) ) & " kg", _u )
		dataType: string
		lineageTag: 332d1a39-88c5-4d2c-9228-fa893e5cab2f
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column RECEITA_TSI = VAR _t = TRIM ( FATO_ITENS_PEDIDO[TRATAMENTO] ) RETURN IF ( UPPER ( _t ) IN { "SEM TRATAMENTO", "SEM TSI", "" }, "SEM TSI", _t )
		dataType: string
		lineageTag: 5fb33af9-da74-4f07-ba5e-6552ac66a0a7
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column KG_POR_UNIDADE = VAR _u = TRIM ( FATO_ITENS_PEDIDO[UNIDADE_ORIGINAL] ) RETURN SWITCH ( _u, "KG", 1, "TON", 1000, "SC25", 25, "SC40", 40, "SC50", 50, "SC60", 60, "BB 550", 550, "BB 600", 600, "BB 680", 680, "BB 700", 700, "BB 720", 720, "BB 760", 760, "BB 800", 800, "BB1000", 1000, DIVIDE ( FATO_ITENS_PEDIDO[QTD_PEDIDA_SACASPADRAO], FATO_ITENS_PEDIDO[QUANTIDADE_ORIGINAL] ) )
		dataType: double
		isHidden
		formatString: #,0.##
		lineageTag: 0a6d6fde-eb09-4a84-8106-b8fd541b8823
		summarizeBy: none

		annotation SummarizationSetBy = User

	column FATOR_BAG =
			-- Quantos BAGS vale 1 unidade da embalagem do pedido (regras por cultura - 16/10/2026)
			VAR _u = TRIM ( FATO_ITENS_PEDIDO[UNIDADE_ORIGINAL] )
			VAR _c = UPPER ( FATO_ITENS_PEDIDO[NOME_CULTURA] )
			VAR _kg = FATO_ITENS_PEDIDO[KG_POR_UNIDADE]
			RETURN
			    SWITCH (
			        TRUE (),
			        CONTAINSSTRING ( _c, "MILHO" ), 1,                      -- milho: sacas como estão no banco
			        CONTAINSSTRING ( _c, "SOJA" ),
			            SWITCH (
			                TRUE (),
			                _u = "5MM", 1,
			                _u = "SC200", 1 / 25,
			                _u = "4MM", 0.8,
			                _u = "140M", 0.028,
			                LEFT ( _u, 2 ) = "BB", 1,                         -- cada bigbag = 1 bag
			                LEFT ( _u, 4 ) = "INAT", 1,
			                DIVIDE ( _kg, 1000 )                              -- saco/kg: peso / 1.000 kg
			            ),
			        CONTAINSSTRING ( _c, "AVEIA" ), DIVIDE ( _kg, 760 ),  -- aveia: bag de 760 kg
			        CONTAINSSTRING ( _c, "TRIGO" ), DIVIDE ( _kg, 1000 ), -- trigo: bag de 1.000 kg
			        DIVIDE ( _kg, 1000 )
			    )
		dataType: double
		isHidden
		formatString: #,0.####
		lineageTag: 7f74f23e-2d4f-4012-a8cb-25dc8f02c7d6
		summarizeBy: none

		annotation SummarizationSetBy = User

