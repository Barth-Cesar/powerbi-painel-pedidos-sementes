	column TEM_TSI = IF ( UPPER ( TRIM ( FATO_ITENS_PEDIDO[TRATAMENTO] ) ) IN { "SEM TRATAMENTO", "SEM TSI", "" }, "SEM TSI", "COM TSI" )
		dataType: string
		lineageTag: 1c1e1121-8b13-4baf-91e1-1420479cc79a
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

